  "cleaning": {
    "feature_regex": "[\\(\\[][\\s]*(?:feat\\.?|featuring|ft\\.?)\\s+[^\\)\\]]+[\\)\\]]",
    "trailing_feature_regex": "\\s+(?:feat\\.?|featuring|ft\\.?)\\s+.*$",
    "korean_bracket_regex": "[\\(\\[][^\\)\\]]*[가-힣ㄱ-ㅎㅏ-ㅣ][^\\)\\]]*[\\)\\]]",
    "japanese_bracket_regex": "[\\(\\[][^\\)\\]]*[ぁ-ゖァ-ヺ一-龥][^\\)\\]]*[\\)\\]]",
    "chinese_bracket_regex": "[\\(\\[][^\\)\\]]*[一-龥][^\\)\\]]*[\\)\\]]",
